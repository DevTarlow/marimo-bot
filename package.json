{
  "name": "marimo-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local desktop agent with Spaces and bots: it reads and writes your files, remembers what matters, and runs scheduled jobs with the app closed. One local model handles text and pictures.",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter @marimo/desktop dev",
    "build": "tsc -b",
    "build:web": "pnpm --filter @marimo/desktop build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "smoke": "pnpm --filter @marimo/desktop smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevTarlow/marimo-bot.git"
  }
}
